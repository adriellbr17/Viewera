{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viewera",
  "version": "0.1.0",
  "identifier": "com.viewera.desktop",
  "build": { "devUrl": "http://127.0.0.1:8787", "frontendDist": "../web" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Viewera", "width": 1160, "height": 850, "minWidth": 600, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws: wss:; media-src 'self' blob:; img-src 'self' data:"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
